# Required Discord bot token
DISCORD_TOKEN=

# Optional YouTube authentication (choose ONE; cookie file takes precedence).
# Recommended if browser-cookie access is unreliable:
# YTDLP_COOKIES_FILE=C:/discord-music-bot/cookies.txt
# Or read cookies from a signed-in browser profile on this same computer:
# YTDLP_COOKIES_FROM_BROWSER=edge
# Supported examples: edge, chrome, firefox, brave, chromium

# Minimum pause between yt-dlp HTTP requests (seconds; bounded by the bot)
YTDLP_SLEEP_REQUESTS=1.0
